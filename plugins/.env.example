# Copy to .env. All container plugins are disabled by default.
# Available profiles: zigbee2mqtt,hass-configurator (comma-separated).
COMPOSE_PROFILES=

# Main stack directory shared with File Editor; plugin data stays under plugins/.
# Relative to plugins/docker-compose.yml, or an absolute path.
HA_DIR=../homeassistant
HA_BACKEND_NETWORK=ha-backend

# Loopback by default; set the server LAN IPv4 address for LAN access.
PLUGINS_BIND_IP=127.0.0.1
ZIGBEE2MQTT_PORT=8080
HASS_CONFIGURATOR_PORT=3218

# Explicit versions; updates are a separate maintenance action.
ZIGBEE2MQTT_IMAGE=koenkk/zigbee2mqtt:2.14.3
HASS_CONFIGURATOR_IMAGE=causticlab/hass-configurator-docker:0.6.0

# Required only for the corresponding enabled plugin.
ZIGBEE_ADAPTER_PATH=/dev/ttyUSB0
HC_USERNAME=admin
# Single quotes preserve special characters such as $ literally.
HC_PASSWORD=''

