# Copy to .env. All container addons are disabled by default.
# Available profiles: zigbee2mqtt,hass-configurator,matter-server,otbr (comma-separated).
COMPOSE_PROFILES=

# Main stack directory shared with File Editor; addon data stays under addons/.
# Relative to addons/docker-compose.yml, or an absolute path.
HA_DIR=../homeassistant
HA_BACKEND_NETWORK=ha-backend

# Loopback by default; set the server LAN IPv4 address for LAN access.
ADDONS_BIND_IP=127.0.0.1
ZIGBEE2MQTT_PORT=8080
HASS_CONFIGURATOR_PORT=3218

# Explicit versions; updates are a separate maintenance action.
ZIGBEE2MQTT_IMAGE=koenkk/zigbee2mqtt:2.14.3
HASS_CONFIGURATOR_IMAGE=causticlab/hass-configurator-docker:0.6.0

# Required only for the corresponding enabled addon.
# Example from the server; verify with ls -l /dev/serial/by-id/.
ZIGBEE_ADAPTER_PATH=/dev/serial/by-id/usb-1a86_USB2.0-Serial-if00-port0
HC_USERNAME=admin
# Single quotes preserve special characters such as $ literally.
HC_PASSWORD=''

# Matter Server uses host networking; its port 5580 is not controlled by ADDONS_BIND_IP.
# Keep the existing image by default; select a compatible version or digest explicitly.
MATTER_SERVER_IMAGE=ghcr.io/home-assistant-libs/python-matter-server:stable
MATTER_PRIMARY_INTERFACE=wlan0
MATTER_BLUETOOTH_ADAPTER=0

# OpenThread Border Router: SONOFF Dongle Plus MG24, OpenThread RCP 2.4.4.
# Use its own by-id path, different from ZIGBEE_ADAPTER_PATH.
OTBR_IMAGE=openthread/border-router:sha-783547e
OTBR_ADAPTER_PATH=/dev/serial/by-id/...
# The host device is mapped to /dev/ttyOTBR inside the container.
# MG24 RCP 2.4.4: 460800 baud, hardware flow control disabled (omit the flag).
OTBR_RCP_DEVICE=spinel+hdlc+uart:///dev/ttyOTBR?uart-baudrate=460800
OTBR_INFRA_IF=wlan0
OTBR_THREAD_IF=wpan0
OTBR_LOG_LEVEL=6
# Host networking; REST API and web UI listen on loopback, independently of ADDONS_BIND_IP.
OTBR_REST_PORT=8081
OTBR_WEB_PORT=8082
