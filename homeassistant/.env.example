# Copy to .env. Use a specific version tag or digest to pin an image.
# start downloads missing images and refreshes latest; other local tags need an explicit pull.
HOMEASSISTANT_IMAGE=ghcr.io/home-assistant/home-assistant:stable
MOSQUITTO_IMAGE=eclipse-mosquitto:latest

# Must match HA_BACKEND_NETWORK in addons/.env.
HA_BACKEND_NETWORK=ha-backend
