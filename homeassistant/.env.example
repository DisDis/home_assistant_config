# Copy to .env and set a separate strong password for each editor.
# Single quotes keep special characters such as $ literal.

# Zigbee coordinator path on the Docker host; use your /dev/serial/by-id path.
ZIGBEE_ADAPTER_PATH=/dev/ttyUSB0

# Matter network interface and BlueZ adapter index (hci0 -> 0, hci1 -> 1).
MATTER_PRIMARY_INTERFACE=wlan0
MATTER_BLUETOOTH_ADAPTER=0

# Cloud Commander (disabled; host port 8001 when restored)
CLOUDCMD_USERNAME=admin
CLOUDCMD_PASSWORD=''

# HASS Configurator / File Editor (port 3218)
HC_USERNAME=admin
HC_PASSWORD=''
