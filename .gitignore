/homeassistant/mosquitto/
/homeassistant/zigbee2mqtt-data/
/homeassistant/matter-data/
/homeassistant/hass-configurator-config/
# Keep legacy runtime directories ignored as well.
/config/
/mosquitto/
/zigbee2mqtt-data/
/matter-data/
/hass-configurator-config/
/tools/cockpit/*.local
tools/cockpit/listen.conf
.storage/
data/
# Clone plugin data directories, but publish only their empty placeholders.
!/plugins/*/data/
/plugins/*/data/*
!/plugins/*/data/.stub

